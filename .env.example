# Server
PORT=3000
ALLOWED_HOSTS=mcp.shortpixel.com,localhost,127.0.0.1

# ShortPixel SPIO API (upstream)
SHORTPIXEL_API_URL=https://api.shortpixel.com/v2
SHORTPIXEL_PLUGIN_VERSION=MCP01

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Logging format: text (human-readable) | json (structured)
LOG_FORMAT=text

# Log full MCP JSON-RPC inbound/outbound payloads (true | false)
LOG_MCP_PROTOCOL=true

# MCP Registry HTTP auth: PUBLIC record only (never the private key)
# Served at https://mcp.shortpixel.com/.well-known/mcp-registry-auth
MCP_REGISTRY_AUTH="v=MCPv1; k=ed25519; p=PASTE_PUBLIC_KEY_HERE"
